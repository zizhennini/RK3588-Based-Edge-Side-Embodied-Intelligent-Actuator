#!/usr/bin/env python3
"""lerobot-record-lite — 遥操作录制关节角度（纯 pyserial，零 lerobot 依赖）

两种模式:
  默认（只录不跟随）: 裸 SYNC_READ 包读主臂角度 → JSON
  --follow（跟随+录制）: 走 hardware.teleop.TeleopPair（30Hz leader→follower，
    G3 帧间限幅 + 起步平滑对齐），需要 scservo_sdk（板端已装）

输出 JSON 格式（两种模式一致，PC 端 scripts/json_to_lerobot.py 可转换）:
  {"fps": 30, "total_frames": N, "duration_s": T,
   "frames": [{"J1": deg, ..., "J6": deg, "t": sec}, ...]}
"""
import sys, os, json, time, datetime, struct, serial

SERIAL_BAUD = 1000000
calib = [(946,3287),(821,3206),(888,3105),(851,3192),(0,4095),(1495,2860)]


def read_leader(ser) -> dict:
    cmd = struct.pack("<BBBBBBB", 0xFF, 0xFF, 0xFE, 4, 0x92, 0x38, 2)
    cks = (~sum(cmd[2:]) & 0xFF)
    ser.write(cmd + struct.pack("<B", cks))
    time.sleep(0.003)
    resp = ser.read(60)
    angles = {}
    for sid in range(1, 7):
        idx = resp.find(bytes([0xFF, 0xFF, sid]))
        if idx >= 0 and idx + 7 < len(resp):
            pos = int.from_bytes(resp[idx+5:idx+7], "little")
            lo, hi = calib[sid - 1]
            mid = (lo + hi) / 2
            angles[f"J{sid}"] = round((pos - mid) * 360 / 4095, 1)
    return angles


def run_follow(args, out_path):
    """--follow: 走 hardware.teleop.TeleopPair（跟随+录制+限幅）"""
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    from hardware.teleop import TeleopPair
    leader_calib = None
    if args.leader_calib:
        with open(args.leader_calib, "r", encoding="utf-8") as f:
            leader_calib = json.load(f)
    pair = TeleopPair(
        leader_port=args.teleop_port, follower_port=args.robot_port,
        fps=args.fps, leader_calibration=leader_calib,
        follower_calibration_path=args.follower_calib,
        max_relative_step_deg=args.max_step,
    )
    with pair:
        input("按 Enter 开始跟随+录制 {} 秒...".format(args.episode_time_s))
        pair.run(args.episode_time_s, out_path=out_path, follow=True)


def main():
    import argparse
    parser = argparse.ArgumentParser(description="遥操作录制关节角度")
    parser.add_argument("--robot.port", dest="robot_port", default="/dev/ttyACM0")
    parser.add_argument("--teleop.port", dest="teleop_port", default="/dev/ttyACM1")
    parser.add_argument("--fps", type=int, default=30)
    parser.add_argument("--episode_time_s", type=int, default=10)
    parser.add_argument("--out", default=None)
    parser.add_argument("--follow", action="store_true",
                        help="跟随模式: 主臂带动从臂（hardware.teleop.TeleopPair）")
    parser.add_argument("--leader-calib", default=None,
                        help="主臂标定 JSON（follow 模式，缺省用内置默认）")
    parser.add_argument("--follower-calib", default="./config/calibration.json",
                        help="从臂标定 JSON（follow 模式）")
    parser.add_argument("--max-step", type=float, default=15.0,
                        help="G3 帧间限幅（度/帧，0=关闭）")
    args = parser.parse_args()

    out_path = args.out or "record_{}.json".format(datetime.datetime.now().strftime("%Y%m%d_%H%M%S"))

    if args.follow:
        run_follow(args, out_path)
        return

    ser = serial.Serial(args.teleop_port, SERIAL_BAUD, timeout=0.05)
    print("按 Enter 开始录制 {} 秒（请先启动遥操作）...".format(args.episode_time_s))
    input()

    frames = []
    t0 = time.perf_counter()
    while time.perf_counter() - t0 < args.episode_time_s:
        loop_t = time.perf_counter()
        angles = read_leader(ser)
        if angles:
            angles["t"] = round(time.perf_counter() - t0, 3)
            frames.append(angles)
        time.sleep(max(1 / args.fps - (time.perf_counter() - loop_t), 0))

    ser.close()

    data = {"fps": args.fps, "total_frames": len(frames), "duration_s": args.episode_time_s, "frames": frames}
    with open(out_path, "w") as f:
        json.dump(data, f, indent=2)
    print("{} 帧, 已保存 {}".format(len(frames), out_path))


if __name__ == "__main__":
    main()
